---
import Visual from './Visual.astro';
import type { Service } from '../content/services';

interface Props {
  service: Service;
  index?: number;
}
const { service, index = 0 } = Astro.props;
// Stagger within a row of three so later rows do not wait long.
const delay = `${(index % 3) * 90}ms`;
const headingId = `${service.id}-title`;
---
<article
  class="item"
  id={service.id}
  aria-labelledby={headingId}
  data-reveal
  style={`--d:${delay}`}
>
  <div class="card">
    <div class="lead">
      <div class="visual" aria-hidden="true">
        <Visual kind={service.visual} />
      </div>
      <header class="head">
        <p class="mono meta">
          <span class="num">{service.number}</span>
          <span class="keys">{service.meta}</span>
        </p>
        <h3 id={headingId}>{service.title}</h3>
        <p class="summary">{service.summary}</p>
      </header>
    </div>

    <div class="detail">
      <div class="block">
        <h4 class="mono label">Examples of technical work</h4>
        <ul class="list">
          {service.work.map((w) => <li>{w}</li>)}
        </ul>
      </div>

      <div class="outputs">
        <h4 class="mono label"><span class="marker" aria-hidden="true"></span>Typical outputs</h4>
        <ul class="list">
          {service.outputs.map((o) => <li>{o}</li>)}
        </ul>
      </div>

      <a class="link" href="/contact/" aria-label={`Discuss this: ${service.title}`}>
        Discuss this <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</article>

<style>
  .item { display: block; scroll-margin-top: 1.5rem; }
  /* Reveal stagger: global rule handles opacity/transform; we only add the delay. */
  .item[data-reveal] { transition-delay: var(--d, 0ms); }

  .card {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--line-strong);
    box-shadow: 0 18px 40px -22px rgba(0, 0, 0, 0.8);
  }
  .card:hover .marker { box-shadow: 0 0 0 4px rgba(197, 242, 58, 0.18); }

  .lead { display: block; }
  .detail {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    flex: 1;
    padding: 0 1.5rem 1.5rem;
  }

  .visual {
    background: var(--bg-raised);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .visual :global(svg) { width: 100%; height: auto; }

  .head { padding: 1.4rem 1.5rem 1.4rem; }
  .meta {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.9rem;
    line-height: 1.5;
  }
  .num { flex: none; white-space: nowrap; color: var(--lime); }
  .keys { flex: 1; min-width: 0; }
  .head h3 { margin-bottom: 0.7rem; }
  .summary { color: var(--text-muted); font-size: 0.97rem; line-height: 1.6; }

  .label {
    font-size: var(--fs-mono);
    font-weight: 500;
    line-height: 1.3;
    margin: 0 0 0.6rem;
  }

  .list { display: grid; gap: 0.45rem; }
  .list li {
    position: relative;
    padding-left: 1.05rem;
    font-size: 0.93rem;
    line-height: 1.55;
    color: var(--text);
  }
  .list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 1px;
    background: var(--text-muted);
  }

  .outputs {
    padding: 1rem 1.1rem;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .outputs .label { display: flex; align-items: center; gap: 0.55rem; margin-bottom: 0.6rem; }
  .outputs .list { font-size: 0.93rem; }
  .marker {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lime);
    transition: box-shadow 0.3s var(--ease);
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    min-height: 44px;
    margin-top: auto;
    padding-inline: 0.15rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, gap 0.2s var(--ease);
  }
  .link:hover { color: var(--lime); gap: 0.65rem; }

  /* Reserve two lines for the meta caption so titles and summaries align across a row. */
  @media (min-width: 640px) {
    .meta { min-height: 3em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .card, .link, .marker { transition: none; }
    .card:hover { transform: none; }
  }
</style>
