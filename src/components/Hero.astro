---
import ContourField from './ContourField.astro';
import { SITE } from '../config/site';
---
<section class="hero" aria-labelledby="hero-heading">
  <ContourField />
  <div class="veil" aria-hidden="true"></div>

  <div class="container body">
    <p class="eyebrow rise" style="--d: 0ms">Geospatial intelligence · Earth observation · GeoAI</p>
    <h1 id="hero-heading" class="rise" style="--d: 90ms">
      Geospatial intelligence, <span class="accent">from orbit to decision.</span>
    </h1>
    <p class="intro rise" style="--d: 180ms">
      {SITE.name} is a remote sensing, GIS and GeoAI consultancy. We combine satellite imagery, computer vision and geospatial data engineering to turn raw spatial data into information that teams can act on.
    </p>
    <div class="actions rise" style="--d: 270ms">
      <a class="btn btn-primary" href="/contact/">Discuss a Project</a>
      <a class="btn btn-ghost" href="/services/">Explore Services</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: 92svh; display: flex; flex-direction: column; justify-content: flex-end;
    padding-top: 7rem; padding-bottom: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }
  /* Vignette keeps text AA-readable: solid at the text side and bottom, open toward the top right. */
  .veil {
    position: absolute; inset: 0; z-index: 0;
    background:
      linear-gradient(to top, var(--bg) 0%, rgba(10, 15, 20, 0.88) 38%, rgba(10, 15, 20, 0.35) 75%, rgba(10, 15, 20, 0.15) 100%),
      linear-gradient(to right, rgba(10, 15, 20, 0.92) 0%, rgba(10, 15, 20, 0.7) 45%, rgba(10, 15, 20, 0) 90%);
  }
  .body { position: relative; z-index: 1; }

  h1 {
    font-size: var(--fs-hero); line-height: 1.02; letter-spacing: -0.035em;
    max-width: 15ch; text-wrap: balance;
  }
  .accent { color: var(--lime); }
  .intro { color: var(--text-muted); max-width: 56ch; margin-top: 1.5rem; font-size: clamp(1rem, 0.4vw + 0.95rem, 1.15rem); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .actions .btn { min-height: 48px; justify-content: center; }

  .rise { animation: rise 0.9s var(--ease) both; animation-delay: var(--d, 0ms); }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  @media (min-width: 640px) {
    .hero { padding-top: 8rem; }
  }
  @media (min-width: 960px) {
    .hero { min-height: 92svh; }
    .intro { max-width: 52ch; }
  }
  @media (max-height: 520px) {
    .hero { min-height: auto; padding-top: 6rem; }
  }
</style>
