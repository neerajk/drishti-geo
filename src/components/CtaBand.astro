---
// Closing call-to-action band used at the bottom of pages. Each link has a real destination.
interface Link { label: string; href: string }
interface Props { heading: string; text?: string; primary: Link; secondary?: Link }
const { heading, text, primary, secondary } = Astro.props;
---
<section class="section cta" aria-labelledby="cta-heading">
  <div class="container cta__inner" data-reveal>
    <div>
      <h2 id="cta-heading">{heading}</h2>
      {text && <p class="lede">{text}</p>}
    </div>
    <div class="cta__actions">
      <a class="btn btn-primary" href={primary.href}>{primary.label}</a>
      {secondary && <a class="btn btn-ghost" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  .cta { border-top: 1px solid var(--line); background: var(--bg-raised); }
  .cta__inner { display: grid; gap: 2rem; align-items: center; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 0.9rem; }
  @media (min-width: 960px) {
    .cta__inner { grid-template-columns: 1.4fr 1fr; }
    .cta__actions { justify-content: flex-end; }
  }
</style>
